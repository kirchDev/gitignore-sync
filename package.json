{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@kirchdev/gitignore-sync",
  "version": "0.5.0",
  "description": "CLI that keeps a repo's .gitignore maintained — curated blocks inside a managed region, re-rendered idempotently, nothing outside it touched.",
  "keywords": [
    "cli",
    "developer-tools",
    "dotfiles",
    "git",
    "gitignore",
    "kirchdev",
    "nodejs"
  ],
  "homepage": "https://github.com/kirchDev/gitignore-sync#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/gitignore-sync/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/gitignore-sync.git"
  },
  "bin": {
    "gis": "./dist/bin/gitignore-sync.mjs",
    "gitignore-sync": "./dist/bin/gitignore-sync.mjs"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "sea:bundle": "vite build -c vite.sea.config.ts",
    "sea:build": "pnpm sea:bundle && node scripts/sea-build.ts",
    "link": "pnpm build && pnpm link --global .",
    "unlink": "pnpm uninstall -g @kirchdev/gitignore-sync && git checkout pnpm-workspace.yaml",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "templates:lock": "node scripts/templates-lock.ts",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm check:policy && pnpm test && pnpm build",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.ts",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postject": "1.0.0-alpha.6",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
