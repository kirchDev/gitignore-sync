{
  "core@v1": [".DS_Store", ".claude/settings.local.json"],
  "git@v1": [
    "*.orig",
    "*.rej",
    "*.BACKUP.*",
    "*.BASE.*",
    "*.LOCAL.*",
    "*.REMOTE.*",
    "*_BACKUP_*.txt",
    "*_BASE_*.txt",
    "*_LOCAL_*.txt",
    "*_REMOTE_*.txt"
  ],
  "node@v1": [
    "node_modules",
    "dist",
    "coverage",
    "logs",
    "*.log",
    "*.tsbuildinfo",
    ".eslintcache",
    ".npm",
    "*.tgz"
  ],
  "go@v1": ["*.exe", "*.test", "*.out", "*.prof"],
  "tofu@v1": [
    ".terraform/",
    "*.tfstate",
    "*.tfstate.*",
    "*.tfvars",
    "!*.tfvars.example",
    "override.tf",
    "override.tf.json",
    ".terraformrc",
    "terraform.rc",
    "crash.log",
    "crash.*.log"
  ],
  "php@v1": ["/vendor", "/.phpunit.cache", "/.phpunit.result.cache"],
  "laravel@v1": [
    "/public/build",
    "/public/hot",
    "/public/storage",
    "/storage/*.key",
    "/bootstrap/ssr",
    "_ide_helper.php",
    "_ide_helper_models.php",
    ".phpstorm.meta.php"
  ],
  "turborepo@v1": [".turbo"],
  "rust@v1": ["/target", "**/*.rs.bk"],
  "playwright@v1": [
    "test-results/",
    "playwright-report/",
    "blob-report/",
    ".last-run.json"
  ],
  "storybook@v1": ["storybook-static"],
  "nuxt@v1": [".nuxt", ".output", ".nitro", ".data"],
  "tauri@v1": ["src-tauri/target", "src-tauri/gen/schemas"],
  "dotenv@v1": [
    ".env",
    ".env.*",
    "!.env.example",
    "!.env.*.example",
    "!.env.testing"
  ],
  "vscode@v1": [
    ".vscode/*",
    "!.vscode/extensions.json",
    "!.vscode/settings.json",
    "!.vscode/mcp.json"
  ],
  "intellij@v1": [".idea/*"],
  "macos@v1": [
    ".AppleDouble",
    ".LSOverride",
    "._*",
    ".Spotlight-V100",
    ".Trashes",
    ".DocumentRevisions-V100",
    ".fseventsd",
    ".TemporaryItems",
    ".VolumeIcon.icns",
    ".com.apple.timemachine.donotpresent",
    ".AppleDB",
    ".AppleDesktop",
    "Network Trash Folder",
    "Temporary Items",
    ".apdisk",
    "*.icloud"
  ],
  "windows@v1": [
    "Thumbs.db",
    "Thumbs.db:encryptable",
    "ehthumbs.db",
    "ehthumbs_vista.db",
    "[Dd]esktop.ini",
    "$RECYCLE.BIN/",
    "*.stackdump",
    "*.cab",
    "*.msi",
    "*.msix",
    "*.msm",
    "*.msp",
    "*.lnk"
  ],
  "vim@v1": ["*.swp", "*.swo", "*.swn", "Session.vim", ".netrwhist"],
  "linux@v1": ["*~", ".fuse_hidden*", ".directory", ".Trash-*", ".nfs*"]
}
